# .env.example - contains no real credentials.
# Copy to ".env" and fill in your own key. ".env" is git-ignored.

# Which LLM backend to use: gemini | openai   ("openai" = any OpenAI-compatible endpoint)
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=gemini-3.7-flash

# Gemini 3 thinking depth: minimal | low | medium | high | default. "low" is faster and lighter on the server
# (and less likely to hit 503 overload). Gemini 2.5 models use LLM_THINKING_BUDGET instead (0 = off).
LLM_THINKING_LEVEL=low
# LLM_THINKING_BUDGET=0

# Models to try, in order, when the main model is overloaded (HTTP 503) or rate limited (429).
# Comma separated; "none" disables. Default for Gemini: gemini-3.5-flash,gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Optional: override the API base URL (needed for non-OpenAI "openai" endpoints, e.g. Groq, OpenRouter, Ollama)
# LLM_BASE_URL=

# Minimum milliseconds between LLM calls (protects free-tier rate limits)
LLM_MIN_INTERVAL_MS=4000

# Where profile / catalog / news cache are stored
DATA_DIR=data

# Optional: comma-separated RSS/Atom feeds for the news panel (name|url pairs)
# NEWS_FEEDS=PC Gamer|https://www.pcgamer.com/rss/,Rock Paper Shotgun|https://www.rockpapershotgun.com/feed

# Optional: real "time to beat" data from IGDB for /playtime (free). Create a Twitch developer application at
# https://dev.twitch.tv/console , then paste its Client ID and a generated Client Secret. Without these the AI estimates alone.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
